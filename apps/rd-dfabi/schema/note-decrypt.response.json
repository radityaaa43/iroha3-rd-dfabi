{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Asset": {
      "enum": [
        "RD",
        "DFABI"
      ],
      "type": "string"
    },
    "ErrorBody": {
      "properties": {
        "code": {
          "description": "not_implemented | bad_request | no_such_wallet | insufficient_notes | aps_not_active | pool_busy | audit_rejected | audit_timeout | committee_unreachable | prove_failed | chain_rejected | internal",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "description": "true when the same request can be retried unchanged (pool_busy, committee_unreachable, audit_timeout).",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "NoteDecryptResp": {
      "properties": {
        "bundle_id": {
          "type": "string"
        },
        "notes": {
          "description": "Empty for a party that owns no output of this bundle: it cannot decrypt anything.",
          "items": {
            "$ref": "#/definitions/OwnNote"
          },
          "type": "array"
        },
        "party": {
          "$ref": "#/definitions/Party"
        }
      },
      "required": [
        "bundle_id",
        "notes",
        "party"
      ],
      "type": "object"
    },
    "OwnNote": {
      "properties": {
        "asset": {
          "$ref": "#/definitions/Asset"
        },
        "commitment": {
          "type": "string"
        },
        "leg": {
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        },
        "role": {
          "description": "recipient | change | reimbursement",
          "type": "string"
        },
        "state": {
          "description": "pending (bundle not final) | unspent | spent",
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "asset",
        "commitment",
        "leg",
        "role",
        "state",
        "value"
      ],
      "type": "object"
    },
    "Party": {
      "description": "Frontend party ids (frontend/server/src/domain.ts PartyId).",
      "enum": [
        "BI",
        "A",
        "B",
        "C"
      ],
      "type": "string"
    }
  },
  "description": "Exactly one of `data` / `error` is set; `ok` says which.",
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/definitions/NoteDecryptResp"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ErrorBody"
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    }
  },
  "required": [
    "ok"
  ],
  "title": "Envelope_for_NoteDecryptResp",
  "type": "object"
}
