{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Asset": {
      "enum": [
        "RD",
        "DFABI"
      ],
      "type": "string"
    },
    "ErrorBody": {
      "properties": {
        "code": {
          "description": "not_implemented | bad_request | no_such_wallet | insufficient_notes | aps_not_active | pool_busy | audit_rejected | audit_timeout | committee_unreachable | prove_failed | chain_rejected | internal",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "description": "true when the same request can be retried unchanged (pool_busy, committee_unreachable, audit_timeout).",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "PoolActivateResp": {
      "properties": {
        "dry_run": {
          "type": "boolean"
        },
        "pools": {
          "items": {
            "$ref": "#/definitions/PoolInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "dry_run",
        "pools"
      ],
      "type": "object"
    },
    "PoolInfo": {
      "properties": {
        "asset": {
          "$ref": "#/definitions/Asset"
        },
        "asset_binding_commitment": {
          "description": "Opaque binding commitment of the asset definition (what the chain shows). null in M1 plans.",
          "type": [
            "string",
            "null"
          ]
        },
        "block": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "notes": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "origin_root": {
          "description": "Root of the origin tree = the sorted initial commitments the activation transaction would carry.",
          "type": "string"
        },
        "pool_id": {
          "type": "string"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/definitions/Route"
            },
            {
              "type": "null"
            }
          ],
          "description": "null until the lifecycle read exists (aps build); dry-run plans have no route yet."
        },
        "tx_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "asset",
        "notes",
        "origin_root",
        "pool_id"
      ],
      "type": "object"
    },
    "Route": {
      "properties": {
        "dataspace": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "incarnation": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "lane": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "dataspace",
        "incarnation",
        "lane"
      ],
      "type": "object"
    }
  },
  "description": "Exactly one of `data` / `error` is set; `ok` says which.",
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/definitions/PoolActivateResp"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ErrorBody"
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    }
  },
  "required": [
    "ok"
  ],
  "title": "Envelope_for_PoolActivateResp",
  "type": "object"
}
