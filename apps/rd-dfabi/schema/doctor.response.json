{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "DoctorCheck": {
      "properties": {
        "detail": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "detail",
        "name",
        "ok"
      ],
      "type": "object"
    },
    "DoctorResp": {
      "properties": {
        "aps_active": {
          "description": "privacy capability Active AND height >= nexus.atomic_private_settlement.activation_height.",
          "type": "boolean"
        },
        "checks": {
          "items": {
            "$ref": "#/definitions/DoctorCheck"
          },
          "type": "array"
        },
        "height": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "aps_active",
        "checks",
        "height"
      ],
      "type": "object"
    },
    "ErrorBody": {
      "properties": {
        "code": {
          "description": "not_implemented | bad_request | no_such_wallet | insufficient_notes | aps_not_active | pool_busy | audit_rejected | audit_timeout | committee_unreachable | prove_failed | chain_rejected | internal",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "description": "true when the same request can be retried unchanged (pool_busy, committee_unreachable, audit_timeout).",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    }
  },
  "description": "Exactly one of `data` / `error` is set; `ok` says which.",
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/definitions/DoctorResp"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ErrorBody"
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    }
  },
  "required": [
    "ok"
  ],
  "title": "Envelope_for_DoctorResp",
  "type": "object"
}
